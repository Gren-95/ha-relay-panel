# Home Assistant — long-lived access token
# (HA -> your profile -> Security -> Long-lived access tokens -> Create token)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-a-long-lived-token

# MQTT broker (only needed for renaming Zigbee2MQTT devices from the UI)
MQTT_URL=mqtt://homeassistant.local:1883

# MariaDB credentials (any values; used by the bundled db container)
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Set to 1 when serving behind a reverse proxy (Caddy / nginx). Enables
# X-Forwarded-For trust so req.ip reflects the real client. Leave off otherwise
# — clients could spoof the header and bypass the login rate limiter.
# TRUST_PROXY=1

# Set to 1 when serving behind TLS (Caddy / nginx). Adds `Secure` to the session
# cookie so browsers only send it over HTTPS. Leave off when testing over plain HTTP.
# SECURE_COOKIE=1

# Optional: HA notify service for alerts on offline sensors/relays or temp deviation
# (e.g. notify.mobile_app_phone). Leave blank to disable.
# NOTIFY_SERVICE=

# Optional: facility-map page that plots the combo sensors (temperature + humidity on
# one device). Set it and every card bound to such a sensor gets a map button that
# opens the marker in a new tab: <KWS_MAP_URL>?sensor=HA%20<base>. Leave unset to hide
# the button. Keep the real internal address here, never in the repo.
# KWS_MAP_URL=http://your-map-host/kws2/index.php

{
  "root": true,
  "reportUnusedDisableDirectives": true,
  "ignorePatterns": ["public/style.css", "public/vendor/**", "public/app.js.orig", "node_modules/**", "scripts/**"],
  "overrides": [
    {
      "files": ["public/js/**/*.js"],
      "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
      "env": { "browser": true, "es2022": true },
      "plugins": ["import"],
      "extends": ["eslint:recommended", "plugin:import/recommended"],
      "settings": { "import/resolver": { "node": { "extensions": [".js"] } } },
      "rules": {
        "no-unused-vars": ["warn", { "args": "none" }],
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "import/no-unresolved": "error",
        "import/named": "error"
      }
    },
    {
      "files": ["server.js", "db.js", "ha.js", "z2m.js", "routes/**/*.js", "lib/**/*.js", "tests/**/*.js", "playwright.config.js", "tailwind.config.js"],
      "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
      "env": { "node": true, "es2022": true },
      "extends": ["eslint:recommended"],
      "rules": {
        "no-unused-vars": ["warn", { "args": "none" }],
        "no-empty": ["error", { "allowEmptyCatch": true }]
      }
    }
  ]
}

{
  "name": "ha-relay-panel",
  "version": "1.0.0",
  "description": "Visual Home Assistant panel: bind relays to temperature sensors as simple thermostats.",
  "type": "commonjs",
  "main": "server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gren-95/ha-relay-panel.git"
  },
  "keywords": [
    "home-assistant",
    "thermostat",
    "relay",
    "iot",
    "mqtt",
    "self-hosted"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/style.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "bash scripts/test.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mqtt": "^5.10.1",
    "mysql2": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3"
  }
}
